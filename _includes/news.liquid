<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news = site.news | sort: 'date' | reverse %}
    {% if include.group_by_year %}
      {% assign news_by_year = news | group_by_exp: 'item', 'item.date | date: "%Y"' %}
      <ul class="nav nav-pills mb-4" id="news-year-tabs" role="tablist">
        {% for year in news_by_year %}
          <li class="nav-item mr-2" role="presentation">
            <a
              class="nav-link px-4{% if forloop.first %} active{% endif %}"
              id="news-{{ year.name }}-tab"
              data-toggle="pill"
              href="#news-{{ year.name }}"
              role="tab"
              aria-controls="news-{{ year.name }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              {{ year.name }}
            </a>
          </li>
        {% endfor %}
      </ul>
      <div class="tab-content" id="news-year-content">
        {% for year in news_by_year %}
          <div
            class="tab-pane fade{% if forloop.first %} show active{% endif %}"
            id="news-{{ year.name }}"
            role="tabpanel"
            aria-labelledby="news-{{ year.name }}-tab"
          >
            {% include news_items.liquid items=year.items %}
          </div>
        {% endfor %}
      </div>
    {% else %}
      {% if include.limit and page.announcements.limit %}
        {% assign news_limit = page.announcements.limit %}
      {% else %}
        {% assign news_limit = news_size %}
      {% endif %}
      {% assign news_scrollable = false %}
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        {% assign news_scrollable = true %}
      {% endif %}
      {% include news_items.liquid items=news limit=news_limit show_year=true scrollable=news_scrollable %}
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
