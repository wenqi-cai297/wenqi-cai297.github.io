{% if include.limit %}
  {% assign news_limit = include.limit %}
{% else %}
  {% assign news_limit = include.items | size %}
{% endif %}
<div class="news-list{% if include.scrollable %} news-list-scrollable{% endif %}">
  {% for item in include.items limit: news_limit %}
    <article class="news-card">
      <time class="news-date" datetime="{{ item.date | date_to_xmlschema }}">
        <span class="news-date-month">{{ item.date | date: '%b' }}</span>
        <span class="news-date-day">{{ item.date | date: '%d' }}</span>
        {% if include.show_year %}
          <span class="news-date-year">{{ item.date | date: '%Y' }}</span>
        {% endif %}
      </time>
      <div class="news-card-content">
        {% if item.inline %}
          {{ item.content | emojify }}
        {% else %}
          <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
        {% endif %}
      </div>
    </article>
  {% endfor %}
</div>
