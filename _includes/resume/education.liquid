<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign education = data[1] %}
  {% for content in education %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-12 col-md-2 text-center date-column">
          {% if content.startDate and content.startDate != '' %}
            {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
            {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
            {% assign date = startDate | append: ' - ' %}
            {% assign date = date | append: endDate %}
          {% elsif content.endDate %}
            {% assign graduationDate = content.endDate | append: '-01' | date: '%b. %Y' %}
            {% assign date = graduationDate | prepend: 'Expected ' %}
          {% else %}
            {% assign date = null %}
          {% endif %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  {% if date %}
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
                  {% endif %}
                </td>
              </tr>
              {% if content.location %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-12 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {% if content.url %}<a href="{{ content.url }}">{{ content.studyType }}</a>{% else %}{{ content.studyType }}{% endif %}
          </h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{% if content.url %}<a href="{{ content.url }}">{{ content.institution }}</a>{% else %}{{ content.institution }}{% endif %}</h6>
          <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{% if content.areaUrl %}<a href="{{ content.areaUrl }}">{{ content.area }}</a>{% else %}{{ content.area }}{% endif %}</h6>
          {% if content.score %}<p class="cv-meta ml-1 ml-md-4">GPA: {{ content.score }}</p>{% endif %}
          {% if content.summary %}<p class="cv-summary ml-1 ml-md-4">{{ content.summary }}</p>{% endif %}
          <ul class="items">
            {% for item in content.courses %}
              <li>
                <span class="item">{{ item }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
