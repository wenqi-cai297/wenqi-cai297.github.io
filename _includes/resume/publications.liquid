<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign publications = data[1] %}
  {% for content in publications %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-12 col-md-2 text-center date-column">
          {% if content.releaseDate %} {% assign date = content.releaseDate | split: '-' | join: '.' %} {% else %} {% assign date = '' %} {% endif %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px">{{ date }}</span>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="col-12 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {% if content.url %}<a href="{{ content.url }}">{{ content.name }}</a>{% else %}{{ content.name }}{% endif %}
          </h6>
          <p class="cv-meta ml-1 ml-md-4">{% if content.publisherUrl %}<a href="{{ content.publisherUrl }}">{{ content.publisher }}</a>{% else %}{{ content.publisher }}{% endif %}</p>
          <p class="cv-summary ml-1 ml-md-4">{{ content.summary }}</p>
          {% if content.code %}<p class="ml-1 ml-md-4"><a href="{{ content.code }}">Code</a></p>{% endif %}
          {% if content.project %}<p class="ml-1 ml-md-4"><a href="{{ content.project }}">Project page</a></p>{% endif %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
